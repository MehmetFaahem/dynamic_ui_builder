@using UIBuilderApp.Models
@inject DesignService DesignService

<div class="component-palette">
    <h3>Components</h3>
    <div class="component-list">
        @foreach (var componentType in GetAvailableComponentTypes())
        {
            <div class="palette-item" 
                 @onclick="@(() => AddComponentToCanvas(componentType))">
                <div class="palette-item-icon">
                    @switch (componentType)
                    {
                        case "Button":
                            <i class="fas fa-square"></i>
                            break;
                        case "TextBox":
                            <i class="fas fa-font"></i>
                            break;
                        case "Label":
                            <i class="fas fa-tag"></i>
                            break;
                        case "Dropdown":
                            <i class="fas fa-caret-down"></i>
                            break;
                        case "Checkbox":
                            <i class="fas fa-check-square"></i>
                            break;
                        case "RadioButton":
                            <i class="fas fa-dot-circle"></i>
                            break;
                        default:
                            <i class="fas fa-cube"></i>
                            break;
                    }
                </div>
                <div class="palette-item-label">@componentType</div>
            </div>
        }
    </div>
</div>

<style>
    .component-palette {
        padding: 10px;
        background-color: #f5f5f5;
        border-right: 1px solid #ddd;
        height: 100%;
    }
    
    .component-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 15px;
    }
    
    .palette-item {
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
        background-color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        transition: all 0.2s;
    }
    
    .palette-item:hover {
        background-color: #f0f7ff;
        border-color: #99c2ff;
        transform: translateY(-2px);
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    
    .palette-item-icon {
        margin-right: 10px;
        width: 24px;
        text-align: center;
    }
</style>

@code {
    private List<string> GetAvailableComponentTypes()
    {
        return new List<string>
        {
            "Button",
            "TextBox",
            "Label",
            "Dropdown",
            "Checkbox",
            "RadioButton"
        };
    }
    
    private void AddComponentToCanvas(string componentType)
    {
        // Create a new component at the center of the canvas
        UIComponentBase? newComponent = CreateComponentByType(componentType);
        
        if (newComponent != null)
        {
            // Position in the center of the canvas
            var canvasWidth = DesignService.CurrentForm.CanvasWidth;
            var canvasHeight = DesignService.CurrentForm.CanvasHeight;
            
            newComponent.X = (canvasWidth / 2) - (newComponent.Width / 2);
            newComponent.Y = (canvasHeight / 2) - (newComponent.Height / 2);
            
            DesignService.AddComponent(newComponent);
        }
    }
    
    private UIComponentBase? CreateComponentByType(string componentType)
    {
        return componentType switch
        {
            "Button" => new ButtonComponent(),
            "TextBox" => new TextBoxComponent(),
            "Label" => new LabelComponent(),
            "Dropdown" => new DropdownComponent(),
            "Checkbox" => new CheckboxComponent(),
            "RadioButton" => new RadioButtonComponent(),
            _ => null
        };
    }
} 