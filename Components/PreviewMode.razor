@using UIBuilderApp.Models
@inject DesignService DesignService

<div class="preview-container">
    <div class="preview-header">
        <h3>Preview Mode</h3>
        <button class="btn btn-primary" @onclick="ExitPreview">Exit Preview</button>
    </div>
    
    <div class="preview-canvas" style="width: @(DesignService.CurrentForm.CanvasWidth)px; height: @(DesignService.CurrentForm.CanvasHeight)px;">
        @foreach (var component in DesignService.CurrentForm.Components.OrderBy(c => c.ZIndex))
        {
            <div class="preview-component" 
                 style="position: absolute; 
                       left: @(component.X)px; 
                       top: @(component.Y)px; 
                       width: @(component.Width)px; 
                       height: @(component.Height)px; 
                       z-index: @component.ZIndex;">
                
                @switch (component.ComponentType)
                {
                    case "Button":
                        <button class="@component.Properties["CssClass"]" style="width: 100%; height: 100%;">
                            @component.Properties["Text"]
                        </button>
                        break;
                        
                    case "TextBox":
                        <input type="text" 
                               class="form-control" 
                               placeholder="@component.Properties["Placeholder"]" 
                               value="@component.Properties["Value"]" 
                               style="width: 100%; height: 100%;" />
                        break;
                        
                    case "Label":
                        <label class="@component.Properties["CssClass"]" style="width: 100%; height: 100%;">
                            @component.Properties["Text"]
                        </label>
                        break;
                        
                    case "Dropdown":
                        <select class="form-select" style="width: 100%; height: 100%;">
                            @foreach (var option in ((string)component.Properties["Options"]).Split(','))
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                        break;
                        
                    case "Checkbox":
                        <div class="form-check" style="height: 100%; display: flex; align-items: center;">
                            <input class="form-check-input" type="checkbox" @(component.Properties.ContainsKey("Checked") && (bool)component.Properties["Checked"] ? "checked" : "") />
                            <label class="form-check-label">@component.Properties["Text"]</label>
                        </div>
                        break;
                        
                    case "RadioButton":
                        <div class="form-check" style="height: 100%; display: flex; align-items: center;">
                            <input class="form-check-input" type="radio" @(component.Properties.ContainsKey("Checked") && (bool)component.Properties["Checked"] ? "checked" : "") />
                            <label class="form-check-label">@component.Properties["Text"]</label>
                        </div>
                        break;
                }
            </div>
        }
    </div>
</div>

<style>
    .preview-container {
        background-color: #f8f9fa;
        padding: 20px;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    
    .preview-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid #dee2e6;
    }
    
    .preview-canvas {
        background-color: white;
        border: 1px solid #dee2e6;
        position: relative;
        margin: 0 auto;
        overflow: auto;
        flex-grow: 1;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    
    .preview-component {
        background-color: transparent;
    }
</style>

@code {
    [Parameter]
    public EventCallback OnExitPreview { get; set; }
    
    private async Task ExitPreview()
    {
        await OnExitPreview.InvokeAsync();
    }
} 